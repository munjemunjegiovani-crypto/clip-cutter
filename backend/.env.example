# Flask (use FLASK_DEBUG=0 in production)
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database (SQLite locally, PostgreSQL when deployed)
DATABASE_URL=sqlite:///clipcutter.db

# Frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Upload limits
MAX_UPLOAD_MB=500
MAX_DURATION_MINUTES=30

# Retention, cleanup worker, and legal contact
FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=600
START_CLEANUP_WORKER=1
TAKEDOWN_EMAIL=
